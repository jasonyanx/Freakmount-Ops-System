# Postgres connection string. Works with Supabase, Vercel Postgres/Neon,
# or a local Postgres instance.
#
# Local example:
#   DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/freakmount
#
# Supabase: Project Settings -> Database -> Connection string -> URI
#   DATABASE_URL=postgresql://postgres.xxxx:yourpassword@aws-0-xxxx.pooler.supabase.com:6543/postgres
#
# Vercel Postgres / Neon (via Vercel's Storage tab): copy the
# POSTGRES_URL value it generates into DATABASE_URL.
DATABASE_URL=

# Shared secret required by GET /api/seed (see README "Deploying to
# Vercel") — lets you (re)load seed data by visiting a URL in the browser
# instead of running `npm run seed` from a terminal. Any random string;
# generate one with `openssl rand -hex 16` or similar.
SEED_SECRET=
